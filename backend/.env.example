# Leave everything below unset to run fully offline with the rule-based agent + mock payments.

# --- Optional LLM agent ---
USE_LLM_AGENT=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Optional live Razorpay test mode ---
RAZORPAY_LIVE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Guardrails ---
MAX_CHECKOUT_AMOUNT=100000
SIMULATED_PAYMENT_FAILURE_RATE=0.1

CORS_ORIGINS=http://localhost:3000
